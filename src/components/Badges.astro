---
// 카탈로그 뱃지(BEST, 추천, NEW, BIO, EXCLUSIVE, LIMITED, SOLD OUT, COMING SOON)를 작은 칩으로
type Props = { badges: string[] };
const { badges } = Astro.props;
---

{
  badges.length > 0 && (
    <ul class="badges">
      {badges.map((b) => (
        <li class:list={['badge', { 'badge--soft': ['BIO', 'COMING SOON', 'SOLD OUT'].includes(b) }]}>{b}</li>
      ))}
    </ul>
  )
}

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .badge {
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 8px;
    border: 1px solid var(--ink);
    line-height: 1.2;
  }

  .badge--soft {
    border-color: var(--hairline);
    color: var(--muted);
  }
</style>
