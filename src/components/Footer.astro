---
import { SITE_DOMAIN, SITE_URL } from '../consts';
---

<footer class="site-footer">
  <a class="label label--muted" href={SITE_URL} target="_blank" rel="noopener">{SITE_DOMAIN}</a>
  <span class="bar" aria-hidden="true"></span>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 26px 0 14px;
    border-top: 1px solid var(--hairline);
  }

  .bar {
    width: 128px;
    height: 4px;
    border-radius: 2px;
    background: var(--ink);
  }
</style>
