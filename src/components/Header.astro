---
import { SITE_NAME, url } from '../consts';
---

<header class="site-header">
  <button class="menu-btn" data-menu-btn aria-expanded="false" aria-label="메뉴 열기">
    <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.4">
      <path d="M0 1h18M0 9h11"></path>
    </svg>
  </button>
  <a class="logo serif" href={url('/')}>{SITE_NAME}</a>
  <a class="finder" href={url('/quiz')} aria-label="내 와인 취향 찾기">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M4 1.5h10l-1 6.5a4 4 0 0 1-8 0z"></path>
      <path d="M9 12v4.5M5.5 16.5h7"></path>
    </svg>
  </a>
  <nav class="nav" data-nav>
    <a href={url('/')}>Collection<span>와인 컬렉션</span></a>
    <a href={url('/producers')}>Producers<span>생산자 소개</span></a>
    <a href={url('/glossary')}>Glossary<span>와인 용어사전</span></a>
    <a href={url('/cocktails')}>Cocktail Recipes<span>칵테일 레시피</span></a>
    <a href={url('/quiz')}>Taste Finder<span>내 와인 취향 찾기</span></a>
  </nav>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: 40px 1fr 40px;
    align-items: center;
    padding: 16px 22px 12px;
    position: relative;
  }

  .menu-btn {
    justify-self: start;
    display: flex;
    padding: 8px 8px 8px 0;
  }

  .logo {
    justify-self: center;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .finder {
    justify-self: end;
    display: flex;
    padding: 6px 0 6px 8px;
  }

  .nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    z-index: 20;
  }

  .nav.open {
    display: block;
  }

  .nav a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 22px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .nav a + a {
    border-top: 1px solid var(--hairline);
  }

  .nav span {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0;
    text-transform: none;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    // 메뉴 바깥을 누르면 닫힘
    document.addEventListener('click', (e) => {
      if (!nav.classList.contains('open')) return;
      const target = e.target as Node;
      if (!nav.contains(target) && !btn.contains(target)) {
        nav.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
