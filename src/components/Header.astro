---
import { SITE_NAME, url } from '../consts';
---

<header class="site-header">
  <button class="menu-btn" data-menu-btn aria-expanded="false" aria-label="메뉴 열기">
    <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.4">
      <path d="M0 1h18M0 9h11"></path>
    </svg>
  </button>
  <a class="logo serif" href={url('/')}>{SITE_NAME}</a>
  <span class="bag" aria-hidden="true">
    <svg width="16" height="18" viewBox="0 0 16 18" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M1.5 5.5h13l-1 11h-11z"></path>
      <path d="M5 5.5V4a3 3 0 0 1 6 0v1.5"></path>
    </svg>
  </span>
  <nav class="nav" data-nav>
    <a href={url('/')}>Collection<span>와인 컬렉션</span></a>
    <a href={url('/cocktails')}>Cocktail Recipes<span>칵테일 레시피</span></a>
    <a href={url('/quiz')}>Taste Finder<span>내 와인 취향 찾기</span></a>
  </nav>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: 40px 1fr 40px;
    align-items: center;
    padding: 16px 22px 12px;
    position: relative;
  }

  .menu-btn {
    justify-self: start;
    display: flex;
    padding: 8px 8px 8px 0;
  }

  .logo {
    justify-self: center;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .bag {
    justify-self: end;
    display: flex;
  }

  .nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    z-index: 20;
  }

  .nav.open {
    display: block;
  }

  .nav a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 22px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .nav a + a {
    border-top: 1px solid var(--hairline);
  }

  .nav span {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0;
    text-transform: none;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  }
</script>
