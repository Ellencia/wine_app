---
import { SITE_NAME, url } from '../consts';

// PC 헤더의 현재 메뉴 강조용 — 경로 앞부분 매칭 (홈은 정확히 일치할 때만)
const path = Astro.url.pathname;
const home = url('/');
const isActive = (p: string) =>
  p === '/' ? path === home || path === home.replace(/\/$/, '') : path.startsWith(url(p));
const menu = [
  { href: '/', en: 'Collection', ko: '와인 컬렉션' },
  { href: '/producers', en: 'Producers', ko: '생산자 소개' },
  { href: '/glossary', en: 'Glossary', ko: '와인 용어사전' },
  { href: '/cocktails', en: 'Cocktail Recipes', ko: '칵테일 레시피' },
  { href: '/quiz', en: 'Taste Finder', ko: '내 와인 취향 찾기' },
];
---

<header class="site-header">
  <button class="menu-btn" data-menu-btn aria-expanded="false" aria-label="메뉴 열기">
    <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.4">
      <path d="M0 1h18M0 9h11"></path>
    </svg>
  </button>
  <a class="logo serif" href={url('/')}>{SITE_NAME}</a>
  <a class="finder" href={url('/quiz')} aria-label="내 와인 취향 찾기">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M4 1.5h10l-1 6.5a4 4 0 0 1-8 0z"></path>
      <path d="M9 12v4.5M5.5 16.5h7"></path>
    </svg>
  </a>
  <nav class="nav" data-nav>
    {
      menu.map((m) => (
        <a
          href={url(m.href)}
          class:list={{ active: isActive(m.href) }}
          aria-current={isActive(m.href) ? 'page' : undefined}
        >
          {m.en}
          <span>{m.ko}</span>
        </a>
      ))
    }
  </nav>
  <!-- PC 전용 검색 — 홈으로 GET 이동해 홈의 ?q= 복원 로직을 태움. 홈에서는 스크립트가 실시간 필터로 가로챔 -->
  <form class="search" role="search" action={url('/')} method="get" data-header-search>
    <svg class="search-icon" width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <circle cx="6.5" cy="6.5" r="4.5"></circle>
      <path d="m10 10 3.5 3.5"></path>
    </svg>
    <input type="search" name="q" placeholder="와인명 · 생산자 · 산지 검색" aria-label="와인 검색" autocomplete="off" />
  </form>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: 40px 1fr 40px;
    align-items: center;
    padding: 16px 22px 12px;
    position: relative;
  }

  .menu-btn {
    justify-self: start;
    display: flex;
    padding: 8px 8px 8px 0;
  }

  .logo {
    justify-self: center;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .finder {
    justify-self: end;
    display: flex;
    padding: 6px 0 6px 8px;
  }

  .search {
    display: none;
  }

  .nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    z-index: 20;
  }

  .nav.open {
    display: block;
  }

  .nav a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 22px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .nav a + a {
    border-top: 1px solid var(--hairline);
  }

  .nav span {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0;
    text-transform: none;
  }

  /* PC: 로고 좌 · 가로 메뉴 중앙 · 검색 우 (디자인 캔버스 헤더) */
  @media (min-width: 1100px) {
    .site-header {
      grid-template-columns: 1fr auto 1fr;
      gap: 24px;
      padding: 22px 56px 18px;
      border-bottom: 1px solid var(--hairline);
    }

    .menu-btn,
    .finder {
      display: none;
    }

    .logo {
      justify-self: start;
      font-size: 26px;
    }

    .nav {
      display: flex;
      position: static;
      gap: 36px;
      background: none;
      border: 0;
    }

    .nav a {
      padding: 6px 0;
      color: var(--muted);
      border-top: 0;
      border-bottom: 1px solid transparent;
      white-space: nowrap;
      transition: color 0.15s;
    }

    .nav a:hover {
      color: var(--ink);
    }

    .nav a.active {
      color: var(--ink);
      border-bottom-color: var(--ink);
    }

    .nav span {
      display: none; /* 한글 서브라벨은 모바일 드롭다운 전용 */
    }

    .search {
      display: block;
      justify-self: end;
      position: relative;
      width: 260px;
      min-width: 180px;
    }

    .search-icon {
      position: absolute;
      top: 50%;
      left: 11px;
      color: var(--muted);
      pointer-events: none;
      transform: translateY(-50%);
    }

    .search input {
      width: 100%;
      border: 1px solid var(--hairline);
      border-radius: 0;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-size: 12px;
      line-height: 1.5;
      padding: 9px 12px 9px 35px;
      appearance: none;
      -webkit-appearance: none;
    }

    .search input::placeholder {
      color: var(--muted);
    }

    .search input::-webkit-search-cancel-button {
      display: none;
    }
  }

  @media print {
    .search {
      display: none !important;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    // 메뉴 바깥을 누르면 닫힘
    document.addEventListener('click', (e) => {
      if (!nav.classList.contains('open')) return;
      const target = e.target as Node;
      if (!nav.contains(target) && !btn.contains(target)) {
        nav.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
