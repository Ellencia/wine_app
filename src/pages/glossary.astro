---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const CATEGORY_ORDER = ['기본', '등급', '산지', '양조', '당도', '시음', '재배'];
const entries = (await getCollection('glossary')).sort((a, b) => a.data.order - b.data.order);
const categories = [...new Set(entries.map((e) => e.data.category))].sort(
  (a, b) => (CATEGORY_ORDER.indexOf(a) + 1 || 99) - (CATEGORY_ORDER.indexOf(b) + 1 || 99),
);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<Base title="Glossary" description="와인 용어사전 — 등급·산지·양조·당도·시음 용어를 초보자 눈높이로 설명">
  <div class="glossary-layout">
  <nav class="toc" aria-label="용어 목차">
    <span class="label label--muted toc-count">Glossary · {entries.length}</span>
    {
      categories.map((c) => (
        <div class="toc-group">
          <span class="label label--muted">{c}</span>
          <div class="toc-links">
            {entries
              .filter((e) => e.data.category === c)
              .map((e) => (
                <a href={`#${e.id}`}>{e.data.term}</a>
              ))}
          </div>
        </div>
      ))
    }
  </nav>

  <div class="head-block">
    <p class="label label--muted page-title">Glossary</p>
    <h1 class="serif title">와인 용어사전</h1>
    <p class="intro">라벨과 테크시트에 자주 나오는 말들. 와인 상세 페이지의 밑줄 친 용어를 누르면 여기로 옵니다.</p>
  </div>

  <div class="entries">
  {
    categories.map((c) => (
      <section class="cat">
        <h2 class="label cat-title">{c}</h2>
        {rendered
          .filter(({ entry }) => entry.data.category === c)
          .map(({ entry, Content }) => (
            <article id={entry.id} class="entry">
              <h3 class="term-title">{entry.data.term}</h3>
              {entry.data.termEn && <p class="label label--muted term-en">{entry.data.termEn}</p>}
              <div class="prose">
                <Content />
              </div>
            </article>
          ))}
      </section>
    ))
  }
  </div>
  </div>
</Base>

<style>
  /* 모바일 순서 유지: 제목 → 목차 → 본문 (DOM은 목차가 먼저 — PC 사이드바용) */
  .glossary-layout {
    display: flex;
    flex-direction: column;
  }

  .head-block {
    order: -1;
  }

  .toc-count {
    display: none;
  }

  .title {
    font-size: 28px;
    font-weight: 500;
    margin: 6px 0 10px;
  }

  .intro {
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 26px;
  }

  .toc {
    display: grid;
    gap: 12px;
    padding: 16px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 34px;
  }

  .toc-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: 4px;
    font-size: 12.5px;
  }

  .toc-links a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--hairline);
  }

  .cat {
    margin-bottom: 36px;
  }

  .cat-title {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 8px;
  }

  .entry {
    padding: 22px 0;
    border-bottom: 1px solid var(--hairline);
    scroll-margin-top: 16px;
  }

  .term-title {
    font-size: 17px;
    font-weight: 500;
    margin-bottom: 2px;
  }

  .term-en {
    margin-bottom: 12px;
  }

  .prose {
    font-size: 13.5px;
    color: #35322e;
    display: grid;
    gap: 10px;
  }

  .prose :global(ul) {
    list-style: disc;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 6px 4px;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }

  .prose :global(th) {
    font-weight: 500;
    color: var(--muted);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  /* PC: 좌측 고정 목차 + 760px 본문 열, 용어/설명 2열 행 (디자인 캔버스 "Glossary") */
  @media (min-width: 1100px) {
    .glossary-layout {
      display: grid;
      grid-template-columns: 220px minmax(0, 760px);
      gap: 0 56px;
      justify-content: start;
      align-items: start;
    }

    .toc {
      grid-column: 1;
      grid-row: 1 / span 2;
      position: sticky;
      top: 32px;
      display: flex;
      flex-direction: column;
      gap: 24px;
      padding: 0;
      border: 0;
      margin-bottom: 0;
      max-height: calc(100vh - 64px);
      overflow-y: auto;
      scrollbar-width: none;
    }

    .toc-count {
      display: block;
      border-bottom: 1px solid var(--hairline);
      padding-bottom: 10px;
    }

    .toc-links {
      flex-direction: column;
      gap: 3px;
      font-size: 12.5px;
    }

    .toc-links a {
      text-decoration: none;
    }

    .toc-links a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .head-block {
      order: 0;
      grid-column: 2;
      margin-bottom: 40px;
    }

    .entries {
      grid-column: 2;
      min-width: 0;
    }

    .title {
      font-size: 40px;
    }

    .intro {
      font-size: 13.5px;
      margin-bottom: 0;
    }

    .entry {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      grid-template-rows: auto 1fr; /* 영문 용어가 한글 제목 바로 아래 붙도록 */
      gap: 4px 32px;
      padding: 26px 0;
      scroll-margin-top: 24px;
    }

    .term-title {
      grid-column: 1;
      font-size: 19px;
      line-height: 1.3;
    }

    .term-en {
      grid-column: 1;
      align-self: start;
      margin-bottom: 0;
    }

    .entry .prose {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
