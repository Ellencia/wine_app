---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../consts';

const cocktails = (await getCollection('cocktails')).sort((a, b) => a.data.order - b.data.order);
const wines = await getCollection('wines');
const wineName = (id?: string) => wines.find((w) => w.id === id)?.data.name;
---

<Base title="Cocktail Recipes" description="올빈와인 와인을 베이스로 만드는 칵테일 레시피와 제조 영상">
  <div class="head">
    <div>
      <p class="label label--muted">Cocktail Recipes</p>
      <h1 class="serif title">와인 칵테일 레시피</h1>
    </div>
    <span class="label label--muted count">{cocktails.length} recipes</span>
  </div>
  <ul class="cards">
    {
      cocktails.map((c) => (
        <li class="card">
          <a href={url(`/cocktails/${c.id}`)}>
            <div class="thumb">
              {c.data.youtubeId ? (
                <img
                  src={`https://i.ytimg.com/vi/${c.data.youtubeId}/hqdefault.jpg`}
                  alt={`${c.data.name} 영상 썸네일`}
                  loading="lazy"
                />
              ) : (
                <span class="label label--muted">Video Coming Soon</span>
              )}
            </div>
            <div class="split-row">
              <span class="label">{c.data.name}</span>
              <span class="label label--muted">{c.data.nameKo}</span>
            </div>
            {wineName(c.data.wineId) && (
              <span class="label label--muted base-wine">Base — {wineName(c.data.wineId)}</span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 10px;
    margin-bottom: 26px;
  }

  .title {
    font-size: 24px;
    font-weight: 500;
    margin-top: 2px;
  }

  .card {
    margin-bottom: 34px;
  }

  .thumb {
    aspect-ratio: 16 / 9;
    background: #ece5db;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .base-wine {
    display: block;
    font-size: 9.5px;
    margin-top: 2px;
  }

  /* PC: 2열 카드 그리드 (디자인 캔버스 "Cocktail Recipes") */
  @media (min-width: 1100px) {
    .head {
      margin-bottom: 40px;
    }

    .title {
      font-size: 40px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 56px;
    }

    .card {
      margin-bottom: 0;
    }

    .thumb {
      margin-bottom: 20px;
    }
  }
</style>
