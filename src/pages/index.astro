---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url, TYPE_LABELS, COUNTRY_ORDER } from '../consts';

const wines = (await getCollection('wines')).sort((a, b) => a.data.order - b.data.order);
const producers = await getCollection('producers');
const producerNames = new Map(producers.map((p) => [p.id, `${p.data.nameKo} ${p.data.name}`]));
const countries = [...new Set(wines.map((w) => w.data.country))].sort(
  (a, b) => (COUNTRY_ORDER.indexOf(a) + 1 || 99) - (COUNTRY_ORDER.indexOf(b) + 1 || 99),
);
const types = Object.keys(TYPE_LABELS).filter((t) => wines.some((w) => w.data.type === t));

// 품종: 빈도순. 상위 몇 개만 칩으로 보이고 나머지는 "품종 더보기" 패널에서 고름 (모바일에서 가로로 길어지지 않게)
const TOP_VARIETIES = 6;
const tagCounts = new Map<string, number>();
for (const w of wines) for (const t of w.data.varietyTags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const varieties = [...tagCounts.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'));
const topVarieties = varieties.slice(0, TOP_VARIETIES);
const moreCount = varieties.length - topVarieties.length;
---

<Base>
  <div class="collection-head">
    <p class="label label--muted">Collection</p>
    <p class="label label--muted" data-count aria-live="polite">{wines.length} wines</p>
  </div>

  <div class="wine-search" role="search">
    <svg class="search-icon" width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <circle cx="6.5" cy="6.5" r="4.5"></circle>
      <path d="m10 10 3.5 3.5"></path>
    </svg>
    <label class="visually-hidden" for="wine-search">와인 검색</label>
    <input
      class="search-input"
      id="wine-search"
      type="search"
      placeholder="와인명 · 생산자 · 산지 검색"
      autocomplete="off"
      spellcheck="false"
      data-search-input
    />
    <button class="search-clear" type="button" aria-label="검색어 지우기" data-search-clear hidden>×</button>
  </div>

  <div class="filter">
    <span class="label label--muted filter-label">타입</span>
    <div class="chips" data-chips="type">
      <button class="chip on" data-value="all">전체</button>
      {types.map((t) => <button class="chip" data-value={t}>{TYPE_LABELS[t]}</button>)}
    </div>
  </div>
  <div class="filter">
    <span class="label label--muted filter-label">품종</span>
    <div class="chips" data-chips="variety">
      <button class="chip on" data-value="all">전체</button>
      {topVarieties.map(([v]) => <button class="chip" data-value={v}>{v}</button>)}
    </div>
    {moreCount > 0 && <button class="chip chip--more" data-more aria-expanded="false">더보기 +{moreCount}</button>}
  </div>

  <div class="variety-panel" data-variety-panel hidden>
    <div class="variety-panel-head">
      <span class="label label--muted">품종 전체 (2종 이상)</span>
      <button class="label label--muted" data-close>닫기</button>
    </div>
    <div class="variety-all">
      {
        varieties.map(([v, n]) => (
          <button class="chip chip--panel" data-panel-value={v}>
            {v}
            <span class="count">{n}</span>
          </button>
        ))
      }
    </div>
  </div>

  {
    countries.map((country) => (
      <section class="country" data-country>
        <h2 class="label country-title">
          {country}
          <span class="label--muted" data-country-count></span>
        </h2>
        <ul class="wine-grid">
          {wines
            .filter((w) => w.data.country === country)
            .map((w) => (
              <li
                data-type={w.data.type}
                data-tags={w.data.varietyTags.join('|')}
                data-search={[
                  w.data.nameKo,
                  w.data.name,
                  producerNames.get(w.data.producer),
                  w.data.country,
                  w.data.region,
                  w.data.varieties,
                  w.data.typeLabel,
                  w.data.vintage,
                  w.data.note,
                ].join(' ')}
              >
                <a href={url(`/wines/${w.id}`)}>
                  <img src={url(w.data.image)} alt={`${w.data.nameKo} 보틀`} loading="lazy" />
                  <span class="name">{w.data.nameKo}</span>
                  <span class="label label--muted sub">
                    {TYPE_LABELS[w.data.type]} · {w.data.vintage}
                  </span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
  <p class="empty label label--muted" data-empty hidden>조건에 맞는 와인이 없습니다.</p>
</Base>

<script>
  // 검색 x 타입 x 품종 필터 (AND). 선택 상태는 URL(?q=&type=&variety=)에 실려 공유·복원됨
  const groups = document.querySelectorAll<HTMLElement>('[data-chips]');
  const varietyGroup = document.querySelector<HTMLElement>('[data-chips="variety"]');
  const items = document.querySelectorAll<HTMLLIElement>('.wine-grid li');
  const sections = document.querySelectorAll<HTMLElement>('[data-country]');
  const total = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const panel = document.querySelector<HTMLElement>('[data-variety-panel]');
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-more]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const searchClear = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const state: Record<string, string> = { type: 'all', variety: 'all' };

  function normalizeSearch(value: string) {
    return value
      .normalize('NFKD')
      .replace(/\p{M}/gu, '')
      .toLocaleLowerCase('ko')
      .trim();
  }

  function apply() {
    let shown = 0;
    const query = normalizeSearch(searchInput?.value ?? '');
    const queryWords = query.split(/\s+/).filter(Boolean);
    items.forEach((li) => {
      const typeOk = state.type === 'all' || li.dataset.type === state.type;
      const tags = (li.dataset.tags || '').split('|');
      const varietyOk = state.variety === 'all' || tags.includes(state.variety);
      const searchText = normalizeSearch(li.dataset.search ?? '');
      const searchOk = queryWords.every((word) => searchText.includes(word));
      const on = typeOk && varietyOk && searchOk;
      li.hidden = !on;
      if (on) shown += 1;
    });
    sections.forEach((sec) => {
      const n = sec.querySelectorAll('li:not([hidden])').length;
      sec.hidden = n === 0;
      const c = sec.querySelector<HTMLElement>('[data-country-count]');
      if (c) c.textContent = ` ${n}`;
    });
    if (total) total.textContent = `${shown} wines`;
    if (empty) empty.hidden = shown > 0;
    const params = new URLSearchParams();
    if (query) params.set('q', searchInput?.value.trim() ?? '');
    if (state.type !== 'all') params.set('type', state.type);
    if (state.variety !== 'all') params.set('variety', state.variety);
    const qs = params.toString();
    history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : ''));
  }

  function togglePanel(open: boolean) {
    if (!panel || !moreBtn) return;
    panel.hidden = !open;
    moreBtn.setAttribute('aria-expanded', String(open));
  }

  function select(group: HTMLElement, value: string) {
    const key = group.dataset.chips || '';
    let chip = group.querySelector<HTMLButtonElement>(`.chip[data-value="${CSS.escape(value)}"]`);
    // 상위 칩에 없는 품종(더보기 패널·상세 페이지 태그에서 진입)은 "선택 칩" 한 칸에만 표시
    const dynamic = group.querySelector<HTMLButtonElement>('.chip--dynamic');
    if (!chip && key === 'variety' && value !== 'all') {
      // 기존 칩을 복제해야 Astro 스코프 CSS 속성(data-astro-cid)이 따라와 같은 모양이 됨
      const template = group.querySelector<HTMLButtonElement>('.chip[data-value="all"]');
      chip = dynamic ?? (template!.cloneNode(false) as HTMLButtonElement);
      chip.className = 'chip chip--dynamic';
      chip.dataset.value = value;
      chip.textContent = value;
      if (!dynamic) {
        group.insertBefore(chip, group.children[1] ?? null); // "전체" 바로 옆 — 스크롤 없이 보이는 자리
        chip.addEventListener('click', () => select(group, chip!.dataset.value || 'all'));
      }
    } else if (dynamic && dynamic !== chip) {
      dynamic.remove();
    }
    state[key] = chip ? value : 'all';
    group.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => c.classList.toggle('on', c.dataset.value === state[key]));
    chip?.scrollIntoView({ inline: 'nearest', block: 'nearest' });
    if (key === 'variety') togglePanel(false);
    apply();
  }

  groups.forEach((group) => {
    group.querySelectorAll<HTMLButtonElement>('.chip:not([data-more])').forEach((chip) => {
      chip.addEventListener('click', () => select(group, chip.dataset.value || 'all'));
    });

    // 모바일의 터치 스와이프와 같은 조작을 PC에서도 마우스 드래그·휠로 지원한다.
    let pressed = false;
    let dragged = false;
    let pointerId = -1;
    let startX = 0;
    let startScrollLeft = 0;

    group.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      pressed = true;
      dragged = false;
      pointerId = event.pointerId;
      startX = event.clientX;
      startScrollLeft = group.scrollLeft;
      group.classList.add('is-grabbing');
    });

    window.addEventListener('pointermove', (event) => {
      if (!pressed || event.pointerId !== pointerId) return;
      const distance = event.clientX - startX;
      if (Math.abs(distance) > 4) dragged = true;
      if (!dragged) return;
      event.preventDefault();
      group.scrollLeft = startScrollLeft - distance;
    });

    const finishDrag = (event: PointerEvent) => {
      if (!pressed || event.pointerId !== pointerId) return;
      pressed = false;
      pointerId = -1;
      group.classList.remove('is-grabbing');
      // pointerup 직후 발생하는 click만 막고 다음 정상 클릭은 허용한다.
      window.setTimeout(() => {
        dragged = false;
      }, 0);
    };
    window.addEventListener('pointerup', finishDrag);
    window.addEventListener('pointercancel', finishDrag);

    group.addEventListener(
      'click',
      (event) => {
        if (!dragged) return;
        event.preventDefault();
        event.stopImmediatePropagation();
      },
      true,
    );

    group.addEventListener(
      'wheel',
      (event) => {
        const maxScrollLeft = group.scrollWidth - group.clientWidth;
        if (maxScrollLeft <= 0) return;
        const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
        const nextScrollLeft = Math.max(0, Math.min(maxScrollLeft, group.scrollLeft + delta));
        if (nextScrollLeft === group.scrollLeft) return;
        event.preventDefault();
        group.scrollLeft = nextScrollLeft;
      },
      { passive: false },
    );
  });
  moreBtn?.addEventListener('click', () => togglePanel(panel?.hidden ?? true));
  panel?.querySelector('[data-close]')?.addEventListener('click', () => togglePanel(false));
  panel?.querySelectorAll<HTMLButtonElement>('[data-panel-value]').forEach((b) => {
    b.addEventListener('click', () => varietyGroup && select(varietyGroup, b.dataset.panelValue || 'all'));
  });

  function updateSearch() {
    if (searchClear) searchClear.hidden = !searchInput?.value;
    apply();
  }

  searchInput?.addEventListener('input', updateSearch);
  searchInput?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !searchInput.value) return;
    searchInput.value = '';
    updateSearch();
  });
  searchClear?.addEventListener('click', () => {
    if (!searchInput) return;
    searchInput.value = '';
    searchInput.focus();
    updateSearch();
  });

  const initial = new URLSearchParams(location.search);
  if (searchInput) searchInput.value = initial.get('q') ?? '';
  if (searchClear) searchClear.hidden = !searchInput?.value;
  groups.forEach((group) => {
    const key = group.dataset.chips || '';
    const v = initial.get(key);
    if (v) select(group, v);
  });
  apply();
</script>

<style>
  .collection-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .wine-search {
    position: relative;
    margin-bottom: 14px;
  }

  .search-icon {
    position: absolute;
    top: 50%;
    left: 11px;
    color: var(--muted);
    pointer-events: none;
    transform: translateY(-50%);
  }

  .search-input {
    width: 100%;
    border: 1px solid var(--hairline);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 12px;
    line-height: 1.5;
    padding: 10px 38px 10px 35px;
    appearance: none;
    -webkit-appearance: none;
  }

  .search-input::placeholder {
    color: var(--muted);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-clear {
    position: absolute;
    top: 0;
    right: 0;
    width: 38px;
    height: 100%;
    color: var(--muted);
    font-size: 18px;
    line-height: 1;
  }

  .search-clear[hidden] {
    display: none;
  }

  /* 필터 행은 항상 한 줄: [라벨][가로 스크롤 칩][더보기] */
  .filter {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .filter-label {
    font-size: 9px;
  }

  .chips {
    display: flex;
    flex-wrap: nowrap;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 1px 0;
    scroll-snap-type: x proximity;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .chips.is-grabbing {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .chips::-webkit-scrollbar {
    display: none;
  }

  .chip {
    flex: 0 0 auto;
    border: 1px solid var(--hairline);
    padding: 6px 10px;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    white-space: nowrap;
    scroll-snap-align: start;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .chip.on {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }

  .chip--more {
    border-style: dashed;
    color: var(--muted);
    padding: 6px 8px;
  }

  .variety-panel {
    margin: 4px 0 20px;
    padding: 14px 0 16px;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .variety-panel-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .variety-panel-head button {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .variety-all {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip--panel .count {
    margin-left: 5px;
    color: var(--muted);
    font-size: 9.5px;
  }

  .country {
    margin-top: 26px;
    margin-bottom: 36px;
  }

  .country-title {
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--hairline);
  }

  .wine-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px 12px;
  }

  .wine-grid a {
    display: block;
    text-align: center;
  }

  .wine-grid img {
    height: 150px;
    margin: 0 auto 12px;
    object-fit: contain;
  }

  .name {
    display: block;
    font-size: 11px;
    line-height: 1.4;
    word-break: keep-all;
  }

  .sub {
    display: block;
    font-size: 9px;
    margin-top: 2px;
  }

  .empty {
    text-align: center;
    padding: 40px 0;
  }
</style>
