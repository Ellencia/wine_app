---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url, TYPE_LABELS, COUNTRY_ORDER } from '../consts';

const wines = (await getCollection('wines')).sort((a, b) => a.data.order - b.data.order);
const countries = [...new Set(wines.map((w) => w.data.country))].sort(
  (a, b) => (COUNTRY_ORDER.indexOf(a) + 1 || 99) - (COUNTRY_ORDER.indexOf(b) + 1 || 99),
);
const types = Object.keys(TYPE_LABELS).filter((t) => wines.some((w) => w.data.type === t));

// 품종 칩: 2종 이상에 쓰인 태그를 빈도순으로 (나머지는 상세 페이지의 태그 링크로 접근)
const tagCounts = new Map<string, number>();
for (const w of wines) for (const t of w.data.varietyTags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const varieties = [...tagCounts.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'))
  .map(([t]) => t);
---

<Base>
  <div class="collection-head">
    <p class="label label--muted">Collection</p>
    <p class="label label--muted" data-count>{wines.length} wines</p>
  </div>

  <div class="filter">
    <span class="label label--muted filter-label">타입</span>
    <div class="chips" data-chips="type">
      <button class="chip on" data-value="all">전체</button>
      {types.map((t) => <button class="chip" data-value={t}>{TYPE_LABELS[t]}</button>)}
    </div>
  </div>
  <div class="filter">
    <span class="label label--muted filter-label">품종</span>
    <div class="chips" data-chips="variety">
      <button class="chip on" data-value="all">전체</button>
      {varieties.map((v) => <button class="chip" data-value={v}>{v}</button>)}
    </div>
  </div>

  {
    countries.map((country) => (
      <section class="country" data-country>
        <h2 class="label country-title">
          {country}
          <span class="label--muted" data-country-count></span>
        </h2>
        <ul class="wine-grid">
          {wines
            .filter((w) => w.data.country === country)
            .map((w) => (
              <li data-type={w.data.type} data-tags={w.data.varietyTags.join('|')}>
                <a href={url(`/wines/${w.id}`)}>
                  <img src={url(w.data.image)} alt={`${w.data.nameKo} 보틀`} loading="lazy" />
                  <span class="name">{w.data.nameKo}</span>
                  <span class="label label--muted sub">
                    {TYPE_LABELS[w.data.type]} · {w.data.vintage}
                  </span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
  <p class="empty label label--muted" data-empty hidden>조건에 맞는 와인이 없습니다.</p>
</Base>

<script>
  // 타입 x 품종 칩 필터 (AND). 선택 상태는 URL(?type=&variety=)에 실려 공유·복원됨
  const groups = document.querySelectorAll<HTMLElement>('[data-chips]');
  const items = document.querySelectorAll<HTMLLIElement>('.wine-grid li');
  const sections = document.querySelectorAll<HTMLElement>('[data-country]');
  const total = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const state: Record<string, string> = { type: 'all', variety: 'all' };

  function apply() {
    let shown = 0;
    items.forEach((li) => {
      const typeOk = state.type === 'all' || li.dataset.type === state.type;
      const tags = (li.dataset.tags || '').split('|');
      const varietyOk = state.variety === 'all' || tags.includes(state.variety);
      const on = typeOk && varietyOk;
      li.hidden = !on;
      if (on) shown += 1;
    });
    sections.forEach((sec) => {
      const n = sec.querySelectorAll('li:not([hidden])').length;
      sec.hidden = n === 0;
      const c = sec.querySelector<HTMLElement>('[data-country-count]');
      if (c) c.textContent = ` ${n}`;
    });
    if (total) total.textContent = `${shown} wines`;
    if (empty) empty.hidden = shown > 0;
    const params = new URLSearchParams();
    if (state.type !== 'all') params.set('type', state.type);
    if (state.variety !== 'all') params.set('variety', state.variety);
    const qs = params.toString();
    history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : ''));
  }

  function select(group: HTMLElement, value: string) {
    const key = group.dataset.chips || '';
    let chip = group.querySelector<HTMLButtonElement>(`.chip[data-value="${CSS.escape(value)}"]`);
    // 칩 목록에 없는 품종(상세 페이지 태그에서 진입)은 칩을 즉석에서 추가
    if (!chip && key === 'variety' && value !== 'all') {
      chip = document.createElement('button');
      chip.className = 'chip';
      chip.dataset.value = value;
      chip.textContent = value;
      group.appendChild(chip);
      chip.addEventListener('click', () => select(group, value));
    }
    state[key] = chip ? value : 'all';
    group.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => c.classList.toggle('on', c.dataset.value === state[key]));
    apply();
  }

  groups.forEach((group) => {
    group.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
      chip.addEventListener('click', () => select(group, chip.dataset.value || 'all'));
    });
  });

  const initial = new URLSearchParams(location.search);
  groups.forEach((group) => {
    const key = group.dataset.chips || '';
    const v = initial.get(key);
    if (v) select(group, v);
  });
  apply();
</script>

<style>
  .collection-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .filter {
    display: grid;
    grid-template-columns: 34px 1fr;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .filter:last-of-type {
    margin-bottom: 26px;
  }

  .filter-label {
    font-size: 9.5px;
  }

  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
    min-width: 0;
  }

  .chips::-webkit-scrollbar {
    display: none;
  }

  .chip {
    flex: 0 0 auto;
    border: 1px solid var(--hairline);
    padding: 7px 12px;
    font-size: 11px;
    letter-spacing: 0.08em;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .chip.on {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }

  .country {
    margin-bottom: 36px;
  }

  .country-title {
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--hairline);
  }

  .wine-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px 12px;
  }

  .wine-grid a {
    display: block;
    text-align: center;
  }

  .wine-grid img {
    height: 150px;
    margin: 0 auto 12px;
    object-fit: contain;
  }

  .name {
    display: block;
    font-size: 11px;
    line-height: 1.4;
    word-break: keep-all;
  }

  .sub {
    display: block;
    font-size: 9px;
    margin-top: 2px;
  }

  .empty {
    text-align: center;
    padding: 40px 0;
  }
</style>
