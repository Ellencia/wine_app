---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WineCard from '../../components/WineCard.astro';
import { url, regionLabel } from '../../consts';

export async function getStaticPaths() {
  const producers = await getCollection('producers');
  return producers.map((producer) => ({ params: { id: producer.id }, props: { producer } }));
}

type Props = { producer: CollectionEntry<'producers'> };
const { producer } = Astro.props;
const d = producer.data;
const wines = (await getCollection('wines'))
  .filter((w) => w.data.producer === producer.id)
  .sort((a, b) => a.data.order - b.data.order);
const paragraphs = d.story.split(/(?<=\.)\s+(?=[가-힣A-Z'"“])/).filter(Boolean);

// 검색엔진용 구조화 데이터 — 생산자는 Organization 엔티티
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: d.name,
  alternateName: d.nameKo,
  description: paragraphs[0],
  address: { '@type': 'PostalAddress', addressCountry: d.country, addressRegion: d.region },
};
---

<Base title={d.nameKo} description={`${d.nameKo} (${d.name}) — ${regionLabel(d.region, d.country)}`}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <a class="label label--muted back-link" href={url('/producers')}>Back to Producers</a>

  <div class="head">
    <h1 class="name-ko">{d.nameKo}</h1>
    <p class="label name-en">{d.name}</p>
    <p class="label label--muted">{regionLabel(d.region, d.country)}</p>
  </div>

  <div class="story">
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>

  <section class="wines">
    <h2 class="label label--muted">Wines <span>{wines.length}</span></h2>
    <ul class="wine-grid">
      {wines.map((w) => <WineCard wine={w} />)}
    </ul>
  </section>
</Base>

<style>
  .head {
    display: grid;
    gap: 6px;
    margin-bottom: 22px;
  }

  .name-ko {
    font-size: 22px;
    font-weight: 500;
    font-family: var(--serif);
  }

  .story {
    display: grid;
    gap: 12px;
    margin-bottom: 36px;
    font-size: 13.5px;
    color: #35322e;
  }

  .wines h2 {
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--hairline);
  }

  /* 카드 내부 마크업·스타일은 WineCard.astro 소유 */
  .wine-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px 12px;
  }
</style>
