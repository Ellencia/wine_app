---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, COUNTRY_ORDER } from '../../consts';

const producers = await getCollection('producers');
const countries = [...new Set(producers.map((p) => p.data.country))].sort(
  (a, b) => (COUNTRY_ORDER.indexOf(a) + 1 || 99) - (COUNTRY_ORDER.indexOf(b) + 1 || 99),
);
---

<Base title="Producers" description="올빈와인이 수입하는 생산자 소개">
  <h1 class="label label--muted page-title">Producers</h1>
  {
    countries.map((country) => (
      <section class="country">
        <h2 class="label country-title">{country}</h2>
        <ul>
          {producers
            .filter((p) => p.data.country === country)
            .map((p) => (
              <li>
                <a class="producer split-row" href={url(`/producers/${p.id}`)}>
                  <span>
                    <span class="name-ko">{p.data.nameKo}</span>
                    <span class="label label--muted name-en">{p.data.name}</span>
                  </span>
                  <span class="label label--muted meta">
                    {p.data.region}
                    <br />
                    {p.data.wineCount} wines
                  </span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .country {
    margin-bottom: 30px;
  }

  .country-title {
    margin-bottom: 4px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--hairline);
  }

  .producer {
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
    align-items: flex-start;
  }

  .name-ko {
    display: block;
    font-size: 13.5px;
  }

  .name-en {
    display: block;
    font-size: 9.5px;
  }

  .meta {
    font-size: 9.5px;
    line-height: 1.6;
    flex: 0 0 auto;
  }

  /* PC: 국가별 2열 목록 + 세리프 국가 제목 (디자인 캔버스 "Producers") */
  @media (min-width: 1100px) {
    .country {
      margin-bottom: 56px;
    }

    .country-title {
      font-family: var(--serif);
      font-size: 30px;
      font-weight: 500;
      letter-spacing: 0.02em;
      text-transform: none;
      line-height: 1.3;
      margin-bottom: 12px;
      padding-bottom: 10px;
    }

    .country ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 56px;
    }

    .producer {
      padding: 18px 0;
      transition: background 0.15s;
    }

    .producer:hover {
      background: var(--bg-canvas);
    }

    .name-ko {
      font-size: 14px;
    }
  }
</style>
