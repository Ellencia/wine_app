---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ScaleDots from '../../components/ScaleDots.astro';
import Badges from '../../components/Badges.astro';
import { url, TYPE_LABELS, regionLabel, webp } from '../../consts';
import { buildTermIndex, linkTerms } from '../../lib/glossary';
import dims from '../../data/wine-image-dims.json';

export async function getStaticPaths() {
  const wines = (await getCollection('wines')).sort((a, b) => a.data.order - b.data.order);
  return wines.map((wine, i) => ({
    params: { slug: wine.id },
    props: {
      wine,
      // 컬렉션을 순서대로 순환하는 이전/다음
      prev: wines.length > 1 ? wines[(i - 1 + wines.length) % wines.length] : null,
      next: wines.length > 1 ? wines[(i + 1) % wines.length] : null,
    },
  }));
}

type Props = {
  wine: CollectionEntry<'wines'>;
  prev: CollectionEntry<'wines'> | null;
  next: CollectionEntry<'wines'> | null;
};
const { wine, prev, next } = Astro.props;
const d = wine.data;
const producer = await getEntry('producers', d.producer);
if (!producer) throw new Error(`[wines/${wine.id}] 생산자 '${d.producer}' 를 찾을 수 없음`);

const ratings = [d.vivino != null ? `Vivino ${d.vivino.toFixed(1)}` : null, d.scores || null].filter(Boolean).join(' / ');
const origin = regionLabel(d.region, d.country);
const rows = [
  ['생산자', producer.data.nameKo],
  ['종류', d.typeLabel || TYPE_LABELS[d.type]],
  ['품종', d.varieties],
  ['빈티지', d.vintage],
  ['산지', origin],
  ['용량 · 도수', `${d.volume}${d.abv != null ? `, ${d.abv}%` : ''}`],
  ['평점', ratings || undefined],
].filter((row) => row[1]);

const cocktails = (await getCollection('cocktails')).filter((c) => c.data.wineId === wine.id);
const storyExcerpt = producer.data.story.split(/(?<=\.)\s/)[0];

// 용어사전 자동 링크: 이름·테크시트·소개문에 나오는 용어를 /glossary#id 로 연결
const termIndex = buildTermIndex(await getCollection('glossary'));
const G = (text: string) => linkTerms(text, termIndex, (id) => url(`/glossary/#${id}`));
const profileVerified = d.profileStatus === 'verified';
const dim = (dims as Record<string, { w: number; h: number }>)[wine.id];

// 검색엔진 리치 결과용 구조화 데이터 — 가격(offers)은 정책상 절대 넣지 않음
const siteOrigin = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, siteOrigin).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: d.nameKo,
      alternateName: d.name,
      image: abs(url(d.image)),
      description: d.note || `${d.varieties} — ${origin}`,
      brand: { '@type': 'Organization', name: producer.data.name },
      countryOfOrigin: d.country,
      url: abs(url(`/wines/${wine.id}`)),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Collection', item: abs(url('/')) },
        { '@type': 'ListItem', position: 2, name: d.nameKo },
      ],
    },
  ],
};
---

<Base title={d.nameKo} description={`${d.nameKo} (${d.name}) — ${d.varieties}, ${d.region}`} ogImage={url(d.image)}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <a class="label label--muted back-link" href={url('/')}>Back to Collection</a>
  <div class="detail-grid">
  <figure class="bottle-panel">
    <img class="bottle" src={url(webp(d.image))} alt={`${d.nameKo} 보틀`} width={dim?.w} height={dim?.h} />
    <figcaption class="label label--muted bottle-caption">{d.volume}{d.abv != null && ` · ${d.abv}%`}</figcaption>
  </figure>
  <div class="detail-body">

  <div class="head">
    <Badges badges={d.badges} />
    <div class="split-row">
      <h1 class="name-ko" set:html={G(d.nameKo)} />
      <span class="label label--muted type">{d.typeLabel || TYPE_LABELS[d.type]}</span>
    </div>
    <p class="label name-en" set:html={G(d.name)} />
    <div class="split-row label label--muted">
      <span set:html={G(origin)} />
      <span set:html={G(d.vintage)} />
    </div>
    {
      d.varietyTags.length > 0 && (
        <ul class="tags">
          {d.varietyTags.map((t) => (
            <li>
              <a class="tag" href={url(`/?variety=${encodeURIComponent(t)}`)}>{t}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {d.note && <p class="desc" set:html={G(d.note)} />}

  <div class="vivino">
    {d.vivino != null && (
      <span class="vivino-score">
        <span class="label label--muted">Vivino</span>
        <strong>{d.vivino.toFixed(1)}</strong>
      </span>
    )}
    <a class="btn" href={d.vivinoUrl} target="_blank" rel="noopener">Vivino에서 보기</a>
  </div>

  <div class="cols">
  <section class="sheet">
    <h2 class="label label--muted">Technical Sheet</h2>
    <dl>
      {
        rows.map(([k, v]) => (
          <div class="row">
            <dt>{k}</dt>
            <dd set:html={G(String(v))} />
          </div>
        ))
      }
      {
        d.awards.length > 0 && (
          <div class="row row--awards">
            <dt>수상</dt>
            <dd>
              <ul>
                {d.awards.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>
  </section>

  <div class="col-right">
  <section class="profile-box">
    <div class="split-row">
      <h2 class="label label--muted">Style Profile</h2>
      <span class:list={['label', 'status', { 'status--verified': profileVerified }]}>
        {profileVerified ? '시음 검수 완료' : '추정치 · 검수 전'}
      </span>
    </div>
    <div class="profile">
      <ScaleDots label="바디" value={d.body} />
      <ScaleDots label="당도" value={d.sweetness} />
      <ScaleDots label="산도" value={d.acidity} />
      <ScaleDots label="타닌" value={d.tannin} />
    </div>
  </section>

  <section class="producer">
    <h2 class="label label--muted">Producer</h2>
    <a class="producer-link split-row" href={url(`/producers/${producer.id}`)}>
      <span class="label">{producer.data.nameKo}</span>
      <span class="label label--muted">{producer.data.region}</span>
    </a>
    <p class="story">{storyExcerpt}</p>
    <a class="label label--muted more" href={url(`/producers/${producer.id}`)}>생산자 소개 전체 보기</a>
  </section>
  </div>
  </div>

  {
    cocktails.length > 0 && (
      <section class="related">
        <h2 class="label label--muted">Cocktail Pairing</h2>
        {cocktails.map((c) => (
          <a class="related-link split-row" href={url(`/cocktails/${c.id}`)}>
            <span class="label">{c.data.name}</span>
            <span class="label label--muted">{c.data.nameKo}</span>
          </a>
        ))}
      </section>
    )
  }

  {
    prev && next && (
      <nav class="pager">
        <a href={url(`/wines/${prev.id}`)}>
          <span class="label label--muted">Prev</span>
          <span class="pager-name">{prev.data.nameKo}</span>
        </a>
        <a class="next" href={url(`/wines/${next.id}`)}>
          <span class="label label--muted">Next</span>
          <span class="pager-name">{next.data.nameKo}</span>
        </a>
      </nav>
    )
  }
  </div>
  </div>
</Base>

<style>
  .bottle {
    height: 300px;
    width: auto;
    margin: 4px auto 28px;
    object-fit: contain;
  }

  .bottle-caption {
    display: none; /* 용량·도수 캡션은 PC 보틀 패널 전용 */
  }

  .head {
    display: grid;
    gap: 10px;
  }

  .name-ko {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    max-width: 70%;
    word-break: keep-all;
  }

  .type {
    padding-top: 4px;
  }

  .name-en {
    margin-top: -4px;
  }

  .desc {
    margin: 22px 0 6px;
    font-size: 13.5px;
    color: #35322e;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .tag {
    display: inline-block;
    font-size: 11px;
    padding: 5px 10px;
    border: 1px solid var(--hairline);
    color: var(--muted);
  }

  .status {
    font-size: 9.5px;
    color: var(--muted);
  }

  .status--verified {
    color: var(--ink);
  }

  /* 용어사전 링크: 점선 밑줄 */
  :global(a.term) {
    text-decoration: underline dotted;
    text-underline-offset: 3px;
    text-decoration-color: #b9b0a2;
  }

  .vivino {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin: 26px 0 34px;
    padding: 14px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .vivino-score {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .vivino-score strong {
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 500;
  }

  .vivino .btn {
    margin-left: auto;
    padding: 10px 18px;
  }

  .sheet,
  .profile-box,
  .producer,
  .related {
    margin-bottom: 36px;
  }

  .sheet h2,
  .profile-box h2,
  .producer h2,
  .related h2 {
    margin-bottom: 8px;
  }

  .sheet .row {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 10px 0;
    border-bottom: 1px solid var(--hairline);
    font-size: 12.5px;
  }

  .sheet dt {
    color: var(--muted);
    flex: 0 0 auto;
  }

  .sheet dd {
    text-align: right;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .row--awards dd ul {
    display: grid;
    gap: 4px;
    font-size: 11.5px;
  }

  .profile {
    display: grid;
    gap: 12px;
    padding-top: 6px;
  }

  .producer-link {
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .story {
    margin: 12px 0 8px;
    font-size: 13px;
    color: #35322e;
  }

  .more {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .related-link {
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid var(--hairline);
    padding-top: 18px;
  }

  .pager a {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .pager .next {
    text-align: right;
  }

  .pager-name {
    font-size: 11.5px;
    word-break: keep-all;
  }

  /* PC: 정보 좌 · 보틀 우(고정), 테크시트/스타일 프로필 2열 (디자인 캔버스 "Wine Detail") */
  @media (min-width: 1100px) {
    .back-link {
      max-width: none;
      margin-bottom: 24px;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 440px;
      gap: 80px;
      align-items: start;
    }

    .detail-body {
      grid-column: 1;
      grid-row: 1;
      min-width: 0;
    }

    .bottle-panel {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 32px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      padding: 40px 0;
      background: var(--bg-canvas);
    }

    .bottle {
      height: 560px;
      margin: 0;
    }

    .bottle-caption {
      display: block;
    }

    .head {
      gap: 12px;
    }

    .name-ko {
      font-family: var(--serif);
      font-size: 40px;
      font-weight: 500;
      line-height: 1.2;
      max-width: none;
    }

    .desc {
      font-size: 15px;
      line-height: 1.7;
    }

    .vivino-score strong {
      font-size: 30px;
    }

    .cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      align-items: start;
      margin-bottom: 36px;
    }

    .cols .sheet {
      margin-bottom: 0;
    }

    .col-right {
      display: grid;
      gap: 36px;
    }

    .col-right .profile-box,
    .col-right .producer {
      margin-bottom: 0;
    }
  }

  /* 인쇄 시 테크시트만 남기고 탐색 요소 제거 */
  @media print {
    .related,
    .pager,
    .vivino .btn,
    .more {
      display: none;
    }

    .bottle {
      height: 220px;
    }
  }
</style>
